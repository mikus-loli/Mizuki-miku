---
import ConfigCarrier from "@components/misc/ConfigCarrier.astro";
import MusicPlayer from "@components/widgets/music-player/MusicPlayer.svelte";
import Pio from "@components/features/pio/Pio.svelte"; // 使用 Svelte 版本的 Pio 组件
import { PageProgressBar } from "@components/control/PageProgressBar";
import { pioConfig, profileConfig, siteConfig, musicPlayerConfig } from "@/config";

const BANNER_HEIGHT = 35;
const BANNER_HEIGHT_EXTEND = 30;
const BANNER_HEIGHT_HOME = BANNER_HEIGHT + BANNER_HEIGHT_EXTEND;

import { PAGE_WIDTH } from "../constants/constants";
import { pathsEqual, url } from "../utils/url-utils";
// 设计令牌（颜色/圆角/间距变量）——全站由它提供 --primary/--card-bg/--radius-large 等。
// 它此前没有任何 import，只因过宽的 import.meta.glob 才被拉进构建图，glob 收敛后必须显式引入，
// 否则 var(--radius-large)/var(--primary) 全都解析不出来（全站退化成直角+无色）。
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/mobile-navbar.css";
import "../styles/wallpaper-navbar-transparent.css";
import "../styles/fancybox-custom.css";
import "../styles/expressive-code.css";
import "../styles/panel-animations.css";
// 桌面端隐藏与右栏音乐控件重复的悬浮播放器胶囊（:has 守卫，移动端不受影响）
import "../styles/music-player-desktop.css";
// 此文件此前没有任何 import，只因 Image.astro / [...slug].astro 里过宽的
// import.meta.glob("../../**") 把它拉进构建图、并被 Vite 生成独立 CSS chunk 挂到
// 每个页面的 <head> 上才「意外生效」。glob 收敛到图片扩展名后必须显式引入，保持行为不变。
import "../styles/mobile-post-list-fix.css";

// 导入新提取的 Head 组件
import AnalyticsScripts from "./partials/AnalyticsScripts.astro";
import HeadTags from "./partials/HeadTags.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	/** 规范 URL（默认取当前路径）；文章页传 getPostUrl(entry) 避免 slug/permalink 重复内容 */
	canonical?: string;
}

let { title, description, lang, setOGTypeArticle, postSlug, canonical } =
	Astro.props;

// canonical URL：默认当前路径（无 query），文章页可覆盖为权威 URL
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteConfig.siteURL).href;

// 首屏就会用到的跨域主机，提前建连（只握手，不下载内容）。
// 统计脚本、歌单接口、图床都在别的子域上，等到元素解析到才握手要多走 1-2 个 RTT。
const preconnectOrigins = ["https://umami.mikus.ink", "https://image.mikus.ink"];
if (musicPlayerConfig.enable && musicPlayerConfig.mode === "meting") {
	try {
		preconnectOrigins.push(new URL(musicPlayerConfig.meting_api).origin);
	} catch {
		// 配置里留了 :server 之类的占位符，解析失败就不预连
	}
}

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;

// 获取导航栏透明模式配置
const navbarTransparentMode =
	siteConfig.banner?.navbar?.transparentMode || "semi";

// 判断是否应该显示顶部高光效果（只在full和semifull模式下显示）
const shouldShowTopHighlight =
	navbarTransparentMode === "full" || navbarTransparentMode === "semifull";

// 布局层不使用 banner 变量：图片由 Banner 组件自行从 siteConfig 取。
// 历史上这里算了两次（一次按 props、一次强制默认），结果都没被消费，已删。
const enableBanner = !!siteConfig.banner.src;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = siteConfig.subtitle
		? `${siteConfig.title} - ${siteConfig.subtitle}`
		: siteConfig.title;
}

let ogImageUrl: string | undefined;
if (siteConfig.generateOgImages && postSlug) {
	ogImageUrl = new URL(`/og/${postSlug}.png`, Astro.site).toString();
}
// 兜底：没有按文章生成的 OG 图时，用站点默认图（社交平台没有 og:image 就不出预览卡）
if (!ogImageUrl) {
	ogImageUrl = new URL("/og-image.webp", Astro.site).toString();
}

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];

// 构建字体配置的 CSS 变量
// ASCII 字体优先级最高（用于英文、数字等），CJK 字体作为回退
let bodyFontFamily = "";
if (siteConfig.font) {
	const fonts: string[] = [];
	// 先添加 ASCII 字体（优先级最高）
	if (siteConfig.font.asciiFont?.fontFamily) {
		const asciiFont = siteConfig.font.asciiFont.fontFamily;
		// 如果字体名包含空格，需要用引号包围
		fonts.push(asciiFont.includes(" ") ? `"${asciiFont}"` : asciiFont);
	}
	// 再添加 CJK 字体（作为回退）
	if (siteConfig.font.cjkFont?.fontFamily) {
		const cjkFont = siteConfig.font.cjkFont.fontFamily;
		// 如果字体名包含空格，需要用引号包围
		fonts.push(cjkFont.includes(" ") ? `"${cjkFont}"` : cjkFont);
	}
	// 添加系统字体作为最终回退
	fonts.push(
		"system-ui",
		"-apple-system",
		"BlinkMacSystemFont",
		"'Segoe UI'",
		"Roboto",
		"Oxygen",
		"Ubuntu",
		"Cantarell",
		"'Open Sans'",
		"'Helvetica Neue'",
		"sans-serif",
	);
	// 组合成完整的 font-family 字符串
	bodyFontFamily = fonts.join(", ");
}
---

<!doctype html>
<html
	lang={siteLang}
	class="bg-[var(--page-bg)] text-[14px] md:text-[16px]"
	data-overlayscrollbars-initialize
>
	<head>
		<meta charset="UTF-8" />

		<!-- 第三方分析脚本 -->
		<AnalyticsScripts
			thirdPartyAnalytics={siteConfig.thirdPartyAnalytics}
		/>

		<!-- SEO Meta Tags, Open Graph, Twitter Card, Favicons, Theme Init -->
		<HeadTags
			title={pageTitle}
			description={description}
			ogImageUrl={ogImageUrl}
			setOGTypeArticle={setOGTypeArticle}
			canonicalUrl={canonicalUrl}
			configHue={configHue}
		/>

		<!-- Canonical URL（避免 slug/permalink 重复内容） -->
		<link rel="canonical" href={canonicalUrl} />

		{preconnectOrigins.map((origin) => <link rel="preconnect" href={origin} />)}

		<!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->
		<slot name="head" />

		<!-- Global CSS variables for page width and hue -->
		<style
			define:vars={{
				configHue,
				"page-width": `${PAGE_WIDTH}rem`,
			}}
		></style>

		<!-- Pio 看板娘样式 - 非渲染阻塞加载 -->
		{
			pioConfig.enable && (
				<Fragment
					set:html={`
						<link rel="stylesheet" href="/pio/static/pio.css" media="print" onload="this.media='all'" />
					`}
				/>
			)
		}

		<link
			rel="alternate"
			type="application/rss+xml"
			title={profileConfig.name}
			href={`${Astro.site}rss.xml`}
		/>
		<script
			defer
			src="https://umami.mikus.ink/script.js"
			data-website-id="f4320e52-859c-4431-bfab-6e43f70aeec0"></script>
	</head>
	<body
		class="min-h-screen"
		class:list={[
			{ "lg:is-home": isHomePage, "enable-banner": enableBanner },
		]}
		style={bodyFontFamily ? `font-family: ${bodyFontFamily};` : ""}
		data-overlayscrollbars-initialize
	>
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-KRX3XGVH"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<!-- 页面顶部渐变高光效果 - 只在full和semifull模式下显示 -->
		{shouldShowTopHighlight && <div class="top-gradient-highlight" />}

		<ConfigCarrier />
		<PageProgressBar
			enable={siteConfig.pageProgressBar?.enable ?? false}
			height={siteConfig.pageProgressBar?.height ?? 3}
			duration={siteConfig.pageProgressBar?.duration ?? 8000}
		/>
		<slot />

		<!-- Music Player - 核心始终加载（当enable=true），UI通过showFloatingPlayer控制 -->
		<MusicPlayer client:idle />

		<!-- Pio 看板娘组件 - 使用 client:idle 确保在浏览器空闲时加载，同时保证组件一定被水合 -->
		{pioConfig.enable && <Pio client:idle />}

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	</body>
</html>

<style
	is:global
	define:vars={{
		bannerOffset,
		"banner-height-home": `${BANNER_HEIGHT_HOME}vh`,
		"banner-height": `${BANNER_HEIGHT}vh`,
	}}
>
	@reference "../styles/main.css";

	@layer components {
		@media (min-width: 1280px) {
			.enable-banner.lg\:is-home #banner-wrapper {
				height: var(--banner-height-home);
				transform: translateY(var(--banner-height-extend));
			}
			.enable-banner #banner-wrapper {
				height: var(--banner-height-home);
			}

			.enable-banner.lg\:is-home #banner {
				height: var(--banner-height-home);
				transform: translateY(0);
			}
			.enable-banner #banner {
				height: var(--banner-height-home);
				transform: translateY(var(--bannerOffset));
			}
			.enable-banner.lg\:is-home #main-grid {
				transform: translateY(var(--banner-height-extend));
			}
			.enable-banner #top-row {
				height: calc(var(--banner-height-home) - 4.5rem);
				@apply transition-all duration-300;
			}
		}

		/* Water waves animation - GPU 加速优化 */
		.waves > .parallax use {
			animation: wave 25s cubic-bezier(0.5, 0.5, 0.45, 0.5) infinite;
			transform: translateZ(0);
			will-change: transform;
			backface-visibility: hidden;
		}
		@keyframes wave {
			0% {
				transform: translate3d(-90px, 0, 0);
			}
			100% {
				transform: translate3d(85px, 0, 0);
			}
		}
	}
	@layer utilities {
		@media (min-width: 1280px) {
			.enable-banner.lg\:is-home #sidebar-sticky {
				top: calc(1rem - var(--banner-height-extend)) !important;
			}
			.enable-banner.lg\:is-home #left-sidebar-sticky {
				top: calc(1rem - var(--banner-height-extend)) !important;
			}
			.enable-banner.lg\:is-home #right-sidebar-sticky {
				top: calc(1rem - var(--banner-height-extend)) !important;
			}
		}
		.navbar-hidden {
			@apply opacity-0 -translate-y-16;
		}
	}
</style>

<script>
	// Swup 页面过渡管理器 - 统一入口
	// 所有功能已重构为模块化架构，详见 src/scripts/ 目录
	import { initSwupManager } from "../scripts/swup-manager";

	// 初始化 Swup 管理器
	initSwupManager();
</script>

<!-- 代码块折叠功能 -->
<script>
	import "../scripts/code-collapse";
</script>

<!-- 主题切换综合性能优化器（包含代码块优化、重型元素优化、性能诊断） -->
<script>
	import "../scripts/theme-optimizer";
</script>
