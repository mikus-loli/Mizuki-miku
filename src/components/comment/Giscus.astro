---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const config = {
	...commentConfig.giscus,
	term: Astro.props.path,
};
---

<div id="giscus-container" class="giscus-container"></div>

<script is:inline define:vars={{ config }}>
	(function () {
		const GISCUS_CONTAINER_ID = "giscus-container";
		const ROOT_MARGIN = "200px";

		// 跨 Swup 换页共享的桥：脚本每次换页都会重新执行，
		// 监听与 observer 必须只保留一份，回调始终指向最新闭包。
		const bridge = (window.__giscusCommentBridge ||= {});
		bridge.cleanup?.();

		function getCurrentPath() {
			const pathname = window.location.pathname;
			return pathname.endsWith("/") && pathname.length > 1
				? pathname.slice(0, -1)
				: pathname;
		}

		async function initGiscus() {
			const container = document.getElementById(GISCUS_CONTAINER_ID);
			if (!container) {
				return;
			}

			let theme = config.theme;
			if (theme === "preferred_color_scheme") {
				const isDark =
					document.documentElement.classList.contains("dark") ||
					document.documentElement
						.getAttribute("data-theme")
						?.includes("dark");
				theme = isDark ? "dark" : "light";
			}

			container.innerHTML = "";

			const script = document.createElement("script");
			script.src = "https://giscus.app/client.js";
			script.setAttribute("data-repo", config.repo);
			script.setAttribute("data-repo-id", config.repoId);
			script.setAttribute("data-category", config.category);
			script.setAttribute("data-category-id", config.categoryId);
			script.setAttribute("data-mapping", config.mapping);
			script.setAttribute("data-term", getCurrentPath());
			script.setAttribute("data-strict", config.strict);
			script.setAttribute(
				"data-reactions-enabled",
				config.reactionsEnabled,
			);
			script.setAttribute("data-emit-metadata", config.emitMetadata);
			script.setAttribute("data-input-position", config.inputPosition);
			script.setAttribute("data-theme", theme);
			script.setAttribute(
				"data-lang",
				config.lang ? config.lang.replace("_", "-") : "en",
			);
			script.setAttribute("data-loading", config.loading);
			script.crossOrigin = "anonymous";
			script.async = true;

			container.appendChild(script);
		}

		function cleanup() {
			if (bridge.observer) {
				bridge.observer.disconnect();
				bridge.observer = null;
			}
			if (bridge.themeObserver) {
				bridge.themeObserver.disconnect();
				bridge.themeObserver = null;
			}
		}

		function setupLazyLoad() {
			const container = document.getElementById(GISCUS_CONTAINER_ID);
			if (!container) {
				return;
			}

			if (bridge.observer) {
				bridge.observer.disconnect();
				bridge.observer = null;
			}

			bridge.observer = new IntersectionObserver(
				(entries) => {
					if (entries[0].isIntersecting) {
						if (bridge.observer) {
							bridge.observer.disconnect();
							bridge.observer = null;
						}
						initGiscus();
					}
				},
				{ rootMargin: ROOT_MARGIN },
			);

			bridge.observer.observe(container);
		}

		bridge.setupLazyLoad = setupLazyLoad;
		bridge.cleanup = cleanup;
		bridge.onContentReplace = () => {
			setTimeout(() => bridge.setupLazyLoad?.(), 200);
		};

		function setupSwupHooks() {
			if (bridge.hooksBound) {
				return;
			}

			const register = () => {
				if (!window.swup?.hooks) {
					return false;
				}
				bridge.hooksBound = true;
				window.swup.hooks.on("content:replace", () => {
					bridge.onContentReplace?.();
				});
				return true;
			};

			if (register()) {
				return;
			}

			// @swup/astro 不派发 swup:enable；短轮询等待 window.swup。
			let attempts = 0;
			const retryTimer = setInterval(() => {
				if (register() || ++attempts >= 50) {
					clearInterval(retryTimer);
				}
			}, 100);
		}

		if (!bridge.globalListenersBound) {
			bridge.globalListenersBound = true;
			document.addEventListener("mizuki:page:loaded", () => {
				bridge.setupLazyLoad?.();
			});
			window.addEventListener("beforeunload", () => {
				bridge.cleanup?.();
			});
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", () => {
				setupLazyLoad();
				setupSwupHooks();
			});
		} else {
			setupLazyLoad();
			setupSwupHooks();
		}

		const themeObserver = new MutationObserver((mutations) => {
			mutations.forEach((mutation) => {
				if (
					mutation.attributeName === "class" ||
					mutation.attributeName === "data-theme"
				) {
					const isDark =
						document.documentElement.classList.contains("dark") ||
						document.documentElement
							.getAttribute("data-theme")
							?.includes("dark");
					const theme = isDark ? "dark" : "light";

					const iframe = document.querySelector(
						"iframe.giscus-frame",
					);
					if (iframe) {
						iframe.contentWindow?.postMessage(
							{ giscus: { setConfig: { theme } } },
							"https://giscus.app",
						);
					}
				}
			});
		});

		bridge.themeObserver = themeObserver;
		themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class", "data-theme"] });
	})();
</script>

<style>
	.giscus-container {
		min-height: 200px;
	}
</style>
