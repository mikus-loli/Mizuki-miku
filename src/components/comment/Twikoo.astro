---
import { commentConfig } from "@/config";

interface Props {
	path: string;
}

const config = {
	...commentConfig.twikoo,
	el: "#tcomment",
	path: Astro.props.path,
};
---

<div id="twikoo-container" class="twikoo-container">
	<div id="tcomment"></div>
</div>

<script is:inline define:vars={{ config }}>
	(function () {
		const TWIKOO_CONTAINER_ID = "twikoo-container";
		const TWIKOO_SCRIPT_URL = "/assets/js/twikoo.all.min.js";
		const ROOT_MARGIN = "200px";
		const MAX_RETRY = 3;
		const RETRY_DELAY = 1000;

		let observer = null;
		let twikooScriptLoaded = false;
		let twikooInitialized = false;

		function getCurrentPath() {
			const pathname = window.location.pathname;
			return pathname.endsWith("/") && pathname.length > 1
				? pathname.slice(0, -1)
				: pathname;
		}

		function createTwikooConfig() {
			return {
				...config,
				path: getCurrentPath(),
				el: "#tcomment",
			};
		}

		async function loadTwikooScript(retryCount = 0) {
			if (twikooScriptLoaded) {
				return true;
			}

			const existingScript = document.getElementById(
				"twikoo-script-loaded",
			);
			if (existingScript) {
				twikooScriptLoaded = true;
				return true;
			}

			return new Promise((resolve) => {
				const script = document.createElement("script");
				script.id = "twikoo-script-loaded";
				script.src = TWIKOO_SCRIPT_URL;
				script.async = true;

				script.onload = () => {
					twikooScriptLoaded = true;
					resolve(true);
				};

				script.onerror = () => {
					if (retryCount < MAX_RETRY) {
						console.warn(
							`[Twikoo] 脚本加载失败，重试 ${retryCount + 1}/${MAX_RETRY}`,
						);
						setTimeout(() => {
							resolve(loadTwikooScript(retryCount + 1));
						}, RETRY_DELAY);
					} else {
						console.error("[Twikoo] 脚本加载失败，已达最大重试次数");
						resolve(false);
					}
				};

				document.head.appendChild(script);
			});
		}

		async function initTwikoo() {
			const commentEl = document.getElementById("tcomment");
			if (!commentEl) {
				return;
			}

			try {
				const loaded = await loadTwikooScript();
				if (!loaded) {
					return;
				}

				if (typeof twikoo === "undefined") {
					console.warn("[Twikoo] twikoo 对象未定义");
					return;
				}

				commentEl.innerHTML = "";
				twikooInitialized = false;

				const dynamicConfig = createTwikooConfig();
				await twikoo.init(dynamicConfig);
				twikooInitialized = true;
			} catch (error) {
				console.error("[Twikoo] 初始化失败:", error);
			}
		}

		function cleanup() {
			if (observer) {
				observer.disconnect();
				observer = null;
			}
		}

		function setupLazyLoad() {
			const container = document.getElementById(TWIKOO_CONTAINER_ID);
			if (!container) {
				return;
			}

			if (observer) {
				observer.disconnect();
				observer = null;
			}

			observer = new IntersectionObserver(
				(entries) => {
					if (entries[0].isIntersecting) {
						if (observer) {
							observer.disconnect();
							observer = null;
						}
						initTwikoo();
					}
				},
				{ rootMargin: ROOT_MARGIN },
			);

			observer.observe(container);
		}

		function setupSwupHooks() {
			if (window.swup?.hooks) {
				window.swup.hooks.on("content:replace", () => {
					twikooInitialized = false;
					setTimeout(setupLazyLoad, 200);
				});
			} else {
				document.addEventListener(
					"swup:enable",
					() => {
						if (window.swup?.hooks) {
							window.swup.hooks.on("content:replace", () => {
								twikooInitialized = false;
								setTimeout(setupLazyLoad, 200);
							});
						}
					},
					{ once: true },
				);
			}
		}

		document.addEventListener("mizuki:page:loaded", () => {
			setupLazyLoad();
		});

		window.addEventListener("beforeunload", cleanup);

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", () => {
				setupLazyLoad();
				setupSwupHooks();
			});
		} else {
			setupLazyLoad();
			setupSwupHooks();
		}
	})();
</script>

<style>
	.twikoo-container {
		min-height: 200px;
	}
</style>
