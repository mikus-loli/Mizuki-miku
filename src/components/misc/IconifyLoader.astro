---
// 全局Iconify加载器组件
// 在页面头部加载，确保图标库尽早可用

export interface Props {
	preloadIcons?: string[]; // 需要预加载的图标列表
	timeout?: number; // 加载超时时间
	retryCount?: number; // 重试次数
}

const { preloadIcons = [], timeout = 10000, retryCount = 3 } = Astro.props;
---

<!-- Iconify图标库加载器 -->
<script is:inline define:vars={{ preloadIcons, timeout, retryCount }}>
	window.__iconifyLoaderOptions = { preloadIcons, timeout, retryCount };
</script>
<script>
	import { initIconifyLoader } from "../../scripts/iconify-loader";

	initIconifyLoader(window.__iconifyLoaderOptions ?? {});
</script>
<!-- 为不支持JavaScript的情况提供备用方案 -->
<noscript>
	<style>
		iconify-icon {
			display: none;
		}
		.icon-fallback {
			display: inline-block;
		}
	</style>
</noscript>
